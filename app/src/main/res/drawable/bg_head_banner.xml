<?xml version="1.0" encoding="utf-8"?>
<!-- 头部渐变（蓝绿） + 半透明装饰圆：layer-list 增加视觉层次 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#00C2A8"
                android:centerColor="#00A0A0"
                android:endColor="#00575D" />
        </shape>
    </item>
    <!-- 左上大装饰圆 -->
    <item
        android:gravity="top|start"
        android:left="-40dp"
        android:top="-56dp">
        <shape android:shape="oval">
            <solid android:color="#14FFFFFF" />
            <size android:width="140dp" android:height="140dp" />
        </shape>
    </item>
    <!-- 右下小装饰圆 -->
    <item
        android:gravity="bottom|end"
        android:right="-20dp"
        android:bottom="-30dp">
        <shape android:shape="oval">
            <solid android:color="#10FFFFFF" />
            <size android:width="90dp" android:height="90dp" />
        </shape>
    </item>
</layer-list>
