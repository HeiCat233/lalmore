<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络权限：加载地图瓦片、发起 POI 检索请求 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- 定位权限：Android 6.0+ 需要在代码里运行时动态申请 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 高德定位 SDK 在 Android 9（API 28）及以下版本的缓存写入 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".ToiletApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NearbyToilet">

        <!--
            高德开放平台申请的 Key。
            申请地址 https://console.amap.com/dev/key/app
            Key 与「包名 com.lalmore.toiletfinder + 签名 SHA1」绑定，
            申请下来后把 YOUR_AMAP_KEY 替换成真实 Key，否则地图瓦片加载不出来。
        -->
        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="4dfd2e4a1e04f6b2bc10335aecd10225" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 详情页仅由 App 内部启动，无需对外暴露 -->
        <activity
            android:name=".ToiletDetailActivity"
            android:exported="false" />
    </application>
</manifest>
